        </mxCell>
        <mxCell id="VVTSpsSsb8YRf7cFVedx-3" value="input_str = f&quot;&quot;&quot; Provide a response based on the query and findings below with as much detail as possible. {guidelines_str}&lt;div&gt;QUERY: {query}&amp;nbsp;&lt;/div&gt;&lt;div&gt;FINDINGS: {all_findings} &quot;&quot;&quot;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-5" y="2650" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="VVTSpsSsb8YRf7cFVedx-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="VVTSpsSsb8YRf7cFVedx-4" target="VVTSpsSsb8YRf7cFVedx-8" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
