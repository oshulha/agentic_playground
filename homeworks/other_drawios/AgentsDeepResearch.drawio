        <mxCell id="aje_9DKnsGEh7tjBooTk-191" value="while (extracted_pages &amp;lt; max_pages)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
