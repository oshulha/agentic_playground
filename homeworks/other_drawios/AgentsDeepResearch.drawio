        <mxCell id="VVTSpsSsb8YRf7cFVedx-15" value="&lt;span style=&quot;font-size: 24px;&quot;&gt;Writer_Agent&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
