    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Plane",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/plane/plane_script.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/plane"
        }
    ],
